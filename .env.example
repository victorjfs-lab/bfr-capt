# Senha principal das paginas /admin, /inscritos e /validacao.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Produção na Hostinger: copie os dados exibidos em MySQL Databases no hPanel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_NAME=nome_do_banco

# Desenvolvimento local: usado somente quando as variáveis MySQL acima não existem.
LEADS_DB_PATH=./data/leads.sqlite
