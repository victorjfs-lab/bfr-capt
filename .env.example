# Senha principal das paginas /admin, /inscritos e /validacao.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Produção na Hostinger: copie os dados exibidos em MySQL Databases no hPanel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_NAME=nome_do_banco

# Desenvolvimento local: usado somente quando as variáveis MySQL acima não existem.
LEADS_DB_PATH=./data/leads.sqlite

# Entrega automatica apos a confirmacao de pagamento na Hotmart.
PUBLIC_SITE_URL=https://nexum.fluxosimplificado.com
HOTMART_HOTTOK=token-secreto-exibido-na-hotmart
# Opcional: restringe o webhook a um unico produto (ID numerico ou ucode).
HOTMART_PRODUCT_ID=

# E-mail de saida da Hostinger. Crie a conta no hPanel antes de preencher.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@seudominio.com
SMTP_PASSWORD=senha-da-conta-de-email
SMTP_FROM_NAME=NEXUM
SMTP_FROM_EMAIL=contato@seudominio.com
